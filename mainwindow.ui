     <property name="styleSheet">
      <string notr="true">QTableWidget {
    background-color: #f8faff;              /* fond très clair bleu-gris */
    border: 1px solid #d0d7e2;              /* bord doux et élégant */
    border-radius: 8px;
    gridline-color: #d0d7e2;
    color: #2e2e2e;                         /* texte bien visible */
    font-family: &quot;Segoe UI&quot;, Arial;
    font-size: 14px;
    alternate-background-color: #eef3ff;    /* alternance légère */
    selection-background-color: #bcd4ff;    /* sélection moderne */
    selection-color: #000;
}

QHeaderView::section {
    background-color: #e6eeff;              /* en-tête bleu clair */
    color: #1a1a1a;
    padding: 6px;
    border: 1px solid #d0d7e2;
    font-weight: bold;
    border-radius: 6px;
}

QTableWidget::item:hover {
    background-color: #dbe7ff;              /* survol */
    color: #000;
}

QTableWidget::item:selected {
    background-color: #a7c4ff;              /* sélection active */
    color: #000;
    font-weight: 600;
}

QScrollBar:vertical {
    border: none;
    background: #f1f4f9;
    width: 10px;
    margin: 0px 0px 0px 0px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #bcd4ff;
    min-height: 25px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #a3c4ff;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}
</string>
