    <widget class="QLineEdit" name="lineEdit_motDePasse">
     <property name="geometry">
      <rect>
       <x>170</x>
       <y>260</y>
       <width>113</width>
       <height>26</height>
      </rect>
     </property>
     <property name="styleSheet">
      <string notr="true">QLineEdit {
    background-color: #ffffff;              /* fond blanc clair et propre */
    color: #2e3a59;                         /* texte bien lisible */
    border: 1.5px solid #dcdcdc;            /* fine bordure douce */
    border-radius: 10px;                    /* coins arrondis modernes */
    padding: 6px 10px;
    font-family: &quot;Segoe UI&quot;;
    font-size: 14px;
    font-weight: 500;
    selection-background-color: #cfe2ff;    /* surlignage bleu clair */
}

/* Effet quand l'utilisateur clique dedans */
QLineEdit:focus {
    border: 1.5px solid #b3d1ff;            /* bleu pastel élégant */
    background-color: #f7faff;              /* léger contraste clair */
    box-shadow: 0 0 8px rgba(179, 209, 255, 0.5);
}
</string>
     </property>
     <property name="echoMode">
      <enum>QLineEdit::EchoMode::Password</enum>
     </property>
    </widget>
