    <widget class="QRadioButton" name="radioButton">
     <property name="geometry">
      <rect>
       <x>140</x>
       <y>500</y>
       <width>101</width>
       <height>24</height>
      </rect>
     </property>
     <property name="styleSheet">
      <string notr="true">QRadioButton {
    color: #2e3a59;                     /* texte lisible */
    font-family: &quot;Segoe UI&quot;;
    font-size: 14px;
    font-weight: 600;
    spacing: 8px;                       /* espace entre le rond et le texte */
}

/* Rond non sélectionné */
QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 9px;                 /* forme circulaire */
    border: 2px solid #b3d1ff;          /* contour bleu pastel */
    background-color: #ffffff;          /* fond blanc clair */
    transition: 0.3s;
}

/* Rond sélectionné */
QRadioButton::indicator:checked {
    background-color: #b3d1ff;          /* bleu pastel rempli */
    border: 2px solid #7aaaff;
}

/* Survol */
QRadioButton::indicator:hover {
    border-color: #7aaaff;
    background-color: #f2f6ff;
}
</string>
     </property>
