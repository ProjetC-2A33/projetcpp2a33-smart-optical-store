    <widget class="QDateEdit" name="dateEdit">
     <property name="geometry">
      <rect>
       <x>160</x>
       <y>300</y>
       <width>141</width>
       <height>41</height>
      </rect>
     </property>
     <property name="styleSheet">
      <string notr="true">/* --- QDATEEDIT MODERNE ET ÉLÉGANT --- */
QDateEdit {
    background-color: #ffffff;              /* blanc pur */
    color: #1e1e2f;                         /* texte gris foncé élégant */
    border: 1.5px solid #e0e6ed;            /* bordure douce */
    border-radius: 12px;                    /* coins arrondis modernes */
    padding: 8px 12px;
    font-family: &quot;Segoe UI&quot;;
    font-size: 14px;
    selection-background-color: #cfe3ff;    /* surlignage bleu clair */
    selection-color: #1e1e2f;
    transition: all 0.25s ease;             /* animation fluide */
    box-shadow: 0 2px 5px rgba(0,0,0,0.05); /* ombre subtile */
}

/* --- SURVOL --- */
QDateEdit:hover {
    background-color: #f4f7ff;              /* bleu clair très doux */
    border-color: #c0d3ff;
    box-shadow: 0 4px 10px rgba(0,0,0,0.08);
}

/* --- FOCUS (quand on clique dessus) --- */
QDateEdit:focus {
    border-color: #7aa2ff;                  /* contour bleu vif */
    box-shadow: 0 0 0 3px rgba(122,162,255,0.2);
}

/* --- BOUTON DÉROULANT --- */
QDateEdit::drop-down {
    border: none;
    background: transparent;
    width: 28px;
    margin-right: 4px;
}

/* --- FLÈCHE MODERNE --- */
QDateEdit::down-arrow {
    image: url(:/qt-project.org/styles/commonstyle/images/arrowdown.png);
    width: 14px;
    height: 14px;
}

/* --- Quand le bouton est pressé --- */
QDateEdit::drop-down:pressed {
    background-color: #e6efff;
    border-radius: 8px;
}
</string>
     </property>
    </widget>
