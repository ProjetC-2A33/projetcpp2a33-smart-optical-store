     <property name="styleSheet">
      <string notr="true">QLabel {
    background-color: #ffffff;              /* même fond que les boutons */
    color: #2e3a59;                         /* texte gris-bleu lisible */
    border: 1px solid #dcdcdc;              /* bordure claire */
    border-radius: 12px;                    /* coins arrondis */
    padding: 8px 16px;                      /* espace intérieur équilibré */
    font-family: &quot;Segoe UI&quot;;
    font-size: 14px;
    font-weight: 600;
    qproperty-alignment: 'AlignCenter';     /* centre le texte dans le label */
    box-shadow: 0 2px 6px rgba(0,0,0,0.05); /* légère ombre comme les boutons */
}

/* Survol du label (effet doux comme le bouton hover) */
QLabel:hover {
    background-color: #f2f6ff;              /* bleu pastel clair */
    border-color: #b3d1ff;
    box-shadow: 0 3px 8px rgba(0,0,0,0.1);
}
</string>
     </property>
     <property name="text">
      <string>Date de naissances</string>
     </property>
