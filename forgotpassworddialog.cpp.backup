#include "forgotpassworddialog.h"
#include "ui_forgotpassworddialog.h"
#include "smtpclient.h"
#include "resendclient.h"
#include "curlemailer.h"

#include <QRegularExpression>
#include <QDebug>
#include <QMessageBox>
#include <QInputDialog>
#include <QDesktopServices>
#include <QUrl>
#include <QSqlQuery>
#include <QSqlError>
#include <QSettings>
#include <QTimer>
#include <QApplication>

ForgotPasswordDialog::ForgotPasswordDialog(QWidget *parent) :
    QDialog(parent),
    ui(new Ui::ForgotPasswordDialog),
    m_emailEnvoye(false)
{
    ui->setupUi(this);
    setWindowTitle("Mot de passe oublié");
    setWindowFlag(Qt::WindowContextHelpButtonHint, false);

    connect(ui->pushButton_send, &QPushButton::clicked,
            this, &ForgotPasswordDialog::onSendClicked);
    connect(ui->pushButton_cancel, &QPushButton::clicked,
            this, &ForgotPasswordDialog::onCancelClicked);
    
    // Connecter le signal textChanged pour envoyer automatiquement
    connect(ui->lineEdit_email, &QLineEdit::textChanged,
            this, &ForgotPasswordDialog::onEmailTextChanged);
    connect(ui->lineEdit_email, &QLineEdit::returnPressed,
            this, &ForgotPasswordDialog::onEmailReturnPressed);
}

ForgotPasswordDialog::~ForgotPasswordDialog()
{
    delete ui;
}

QString ForgotPasswordDialog::getEmail() const
{
    return ui->lineEdit_email->text().trimmed();
}

void ForgotPasswordDialog::onSendClicked()
{
    QString email = ui->lineEdit_email->text().trimmed();

    if (email.isEmpty()) {
        afficherMessageErreur("Veuillez saisir votre adresse email.");
        return;
    }

    if (!validerEmail(email)) {
        afficherMessageErreur("Adresse email invalide.\nVeuillez saisir une adresse email valide (ex: votre.email@gmail.com)");
        return;
    }

    // Envoyer l'email automatiquement
    envoyerEmailAutomatiquement(email);
}

void ForgotPasswordDialog::onEmailReturnPressed()
{
    onSendClicked();
}

void ForgotPasswordDialog::onEmailTextChanged()
{
    // Cacher l'erreur quand l'utilisateur tape
    ui->label_error->setVisible(false);
}

void ForgotPasswordDialog::onCancelClicked()
{
    reject();
}

void ForgotPasswordDialog::afficherMessageErreur(const QString& message)
{
    ui->label_error->setText(message);
    ui->label_error->setVisible(true);
}

bool ForgotPasswordDialog::validerEmail(const QString& email)
{
    QRegularExpression regex(R"((^[\w\.-]+@[\w\.-]+\.[A-Za-z]{2,}$))");
    return regex.match(email).hasMatch();
}

void ForgotPasswordDialog::envoyerEmailAutomatiquement(const QString& email)
{
    // Vérifier si l'email existe dans la table EMPLOYE et récupérer le mot de passe
    QSqlQuery query;
    query.prepare("SELECT \"MOT_DE_PASSE_EMPLOYE\", NOM, PRENOM FROM EMPLOYE WHERE UPPER(\"EMAIL\") = UPPER(:email)");
    query.bindValue(":email", email);
    
    QString motDePasseEmploye;
    QString nomEmploye;
    QString prenomEmploye;
    bool emailTrouve = false;
    
    if (query.exec() && query.next()) {
        motDePasseEmploye = query.value(0).toString();
        nomEmploye = query.value(1).toString();
        prenomEmploye = query.value(2).toString();
        emailTrouve = true;
    }
    
    if (!emailTrouve || motDePasseEmploye.isEmpty()) {
        QMessageBox::warning(this, "Email introuvable",
                             QString("Aucun employé trouvé avec l'email : %1\n\n"
                                     "Ou le mot de passe n'est pas défini pour cet employé.\n\n"
                                     "Veuillez vérifier votre adresse email ou contacter l'administrateur.")
                             .arg(email));
        return;
    }
    
    // Afficher un message de progression
    ui->label_error->setText("Envoi de l'email en cours...");
    ui->label_error->setStyleSheet("color: #4d73ff;");
    ui->label_error->setVisible(true);
    QApplication::processEvents();
    
    // Construire le message
    QString nomComplet = QString("%1 %2").arg(prenomEmploye, nomEmploye).trimmed();
    if (nomComplet.isEmpty()) {
        nomComplet = "Cher employé";
    }
    
    QString subject = "Récupération de votre mot de passe - Application Gestion Employés";
    QString body = QString(
        "========================================\n"
        "  RECUPERATION DE MOT DE PASSE\n"
        "  Application Gestion Employés\n"
        "========================================\n\n"
        "Bonjour %1,\n\n"
        "Vous avez demandé la récupération de votre mot de passe.\n\n"
        "VOICI VOS IDENTIFIANTS DE CONNEXION :\n\n"
        "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
        "  EMAIL : %2\n"
        "  MOT DE PASSE : %3\n"
        "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n"
        "Vous pouvez maintenant vous connecter à l'application avec ces identifiants.\n\n"
        "IMPORTANT : Pour votre sécurité, nous vous recommandons fortement de changer votre mot de passe après votre première connexion.\n\n"
        "Si vous n'avez pas fait cette demande, veuillez contacter l'administrateur immédiatement.\n\n"
        "Cordialement,\n"
        "L'équipe de l'Application Gestion Employés\n\n"
        "========================================\n")
        .arg(nomComplet, email, motDePasseEmploye);
    
    // Envoyer l'email via curl
    QString error;
    CurlEmailer emailer;
    bool success = emailer.sendEmail(email, subject, body, &error);
    
    if (success) {
        m_emailEnvoye = true;
        ui->label_error->setText("✅ Email envoyé avec succès ! Vérifiez votre boîte de réception.");
        ui->label_error->setStyleSheet("color: #4caf50;");
        ui->label_error->setVisible(true);
        
        QMessageBox::information(this, "Email envoyé",
                                 QString("✅ Votre mot de passe a été envoyé à :\n%1\n\n"
                                        "Vérifiez votre boîte Gmail pour recevoir votre mot de passe.\n\n"
                                        "Vous pouvez maintenant vous connecter avec votre email et votre mot de passe.")
                                 .arg(email));
        
        // Fermer le dialogue après un court délai
        QTimer::singleShot(2000, this, [this]() {
            accept();
        });
    } else {
        ui->label_error->setText("❌ Erreur lors de l'envoi de l'email.");
        ui->label_error->setStyleSheet("color: #ff8a80;");
        ui->label_error->setVisible(true);
        
        QMessageBox::critical(this, "Erreur d'envoi",
            QString("❌ Impossible d'envoyer l'email.\n\n"
                   "Erreur : %1\n\n"
                   "Vérifiez votre connexion Internet.")
            .arg(error));
    }
}

void ForgotPasswordDialog::envoyerEmailTest(const QString& emailDestinataire)
{
    // Afficher message de progression
    ui->label_error->setText("📧 Envoi de l'email de test en cours...");
    ui->label_error->setStyleSheet("color: #4d73ff;");
                                           "• Oui : Je vais créer le mot de passe d'application\n"
                                           "• Non : Je dois d'abord l'activer",
                                           QMessageBox::Yes | QMessageBox::No,
                                           QMessageBox::No);
        
        if (choice == QMessageBox::No) {
            // Ouvrir la page de sécurité pour activer la validation en 2 étapes
            QDesktopServices::openUrl(QUrl("https://myaccount.google.com/security"));
            QMessageBox::information(this, "Activer la validation en 2 étapes",
                                    "ÉTAPES IMPORTANTES :\n\n"
                                    "1. Sur la page qui s'est ouverte, trouvez 'Validation en 2 étapes'\n"
                                    "2. Cliquez sur 'Commencer' pour activer la validation en 2 étapes\n"
                                    "3. Suivez les instructions pour configurer (téléphone, etc.)\n"
                                    "4. Une fois activée, revenez ici et cliquez sur 'Oui'\n\n"
                                    "⚠️ La validation en 2 étapes est OBLIGATOIRE pour créer un mot de passe d'application.");
            return;
        }
        
        // Ouvrir automatiquement la page Google pour créer le mot de passe d'application
        QDesktopServices::openUrl(QUrl("https://myaccount.google.com/apppasswords"));
        
        QMessageBox::information(this, "Créer un mot de passe d'application",
                                "ÉTAPES :\n\n"
                                "1. Sur la page qui s'est ouverte, sélectionnez 'Autre (nom personnalisé)'\n"
                                "2. Entrez 'Application Gestion' comme nom\n"
                                "3. Cliquez sur 'Générer'\n"
                                "4. Copiez le mot de passe de 16 caractères affiché\n"
                                "5. Revenez ici et saisissez les informations demandées\n\n"
                                "⚠️ Si vous voyez 'Le paramètre n'est pas disponible',\n"
                                "cela signifie que la validation en 2 étapes n'est pas activée.\n"
                                "Vous devez d'abord l'activer sur votre compte Google.");
        
        bool configOk = false;
        smtpUser = QInputDialog::getText(
            this,
            "Configuration Gmail",
            "Votre adresse Gmail (expéditeur) :",
            QLineEdit::Normal,
            QString(),
            &configOk
        ).trimmed();

        if (!configOk || smtpUser.isEmpty()) {
            QMessageBox::warning(this, "Configuration annulée",
                                 "La configuration a été annulée.\n"
                                 "L'envoi d'email ne fonctionnera pas sans cette configuration.");
            return;
        }

        QRegularExpression regex(R"((^[\w\.-]+@[\w\.-]+\.[A-Za-z]{2,}$))");
        if (!regex.match(smtpUser).hasMatch()) {
            QMessageBox::warning(this, "Email invalide",
                                 "Adresse Gmail invalide.");
            return;
        }

        smtpPassword = QInputDialog::getText(
            this,
            "Mot de passe d'application",
            "Collez le mot de passe d'application de 16 caractères :",
            QLineEdit::Password,
            QString(),
            &configOk
        ).trimmed();

        if (!configOk || smtpPassword.isEmpty()) {
            QMessageBox::warning(this, "Configuration annulée",
                                 "La configuration a été annulée.\n"
                                 "L'envoi d'email ne fonctionnera pas sans cette configuration.");
            return;
        }
        
        // Nettoyer le mot de passe : enlever TOUS les caractères non-alphanumériques
        QString passwordCleaned = smtpPassword;
        passwordCleaned.remove(QRegularExpression("\\s")); // Enlever tous les espaces
        passwordCleaned.remove("-"); // Enlever les tirets
        passwordCleaned.remove(" "); // Enlever les espaces (au cas où)
        passwordCleaned.remove("\t"); // Enlever les tabulations
        passwordCleaned.remove("\n"); // Enlever les retours à la ligne
        passwordCleaned.remove("\r"); // Enlever les retours chariot
        
        // Vérifier que le mot de passe ne contient que des caractères alphanumériques
        QRegularExpression alphanumRegex("^[A-Za-z0-9]+$");
        if (!alphanumRegex.match(passwordCleaned).hasMatch()) {
            QMessageBox::warning(this, "Mot de passe invalide",
                                 "Le mot de passe d'application ne doit contenir que des lettres et des chiffres.\n\n"
                                 "Veuillez vérifier que vous avez copié le bon mot de passe.");
            return;
        }
        
        if (passwordCleaned.length() != 16) {
            QMessageBox::warning(this, "Mot de passe invalide",
                                 QString("Le mot de passe doit contenir exactement 16 caractères.\n\n"
                                        "Vous avez saisi %1 caractères.\n\n"
                                        "Veuillez vérifier que vous avez copié le mot de passe complet.")
                                 .arg(passwordCleaned.length()));
            return;
        }
        
        // Sauvegarder la configuration
        QString userCleaned = smtpUser.trimmed().toLower();
        settings.setValue("smtp/user", userCleaned);
        settings.setValue("smtp/password", passwordCleaned);
        
        smtpUser = userCleaned;
        smtpPassword = passwordCleaned;
        
        QMessageBox::information(this, "Configuration terminée",
                                "Configuration sauvegardée avec succès !\n\n"
                                "Les emails seront maintenant envoyés automatiquement.");
    } else {
        // Si la configuration existe déjà, nettoyer pour être sûr
        smtpUser = smtpUser.trimmed().toLower();
        smtpPassword = smtpPassword.trimmed();
        // Nettoyer TOUS les caractères non-alphanumériques sauf les caractères valides du mot de passe d'application
        smtpPassword.remove(QRegularExpression("\\s")); // Enlever tous les espaces
        smtpPassword.remove("-"); // Enlever les tirets
        smtpPassword.remove(" "); // Enlever les espaces (au cas où)
        smtpPassword.remove("\t"); // Enlever les tabulations
        smtpPassword.remove("\n"); // Enlever les retours à la ligne
        smtpPassword.remove("\r"); // Enlever les retours chariot
        
        // Vérifier que le mot de passe a toujours 16 caractères après nettoyage
        if (smtpPassword.length() != 16) {
            QMessageBox::warning(this, "Configuration invalide",
                                 QString("Le mot de passe sauvegardé n'est pas valide.\n\n"
                                        "Longueur : %1 caractères (attendu : 16)\n\n"
                                        "Veuillez reconfigurer les paramètres SMTP.")
                                 .arg(smtpPassword.length()));
            
            // Réinitialiser la configuration
            settings.remove("smtp/user");
            settings.remove("smtp/password");
            
            // Redemander la configuration
            return envoyerEmailAutomatiquement(email);
        }
    }
    
    // Utiliser les paramètres nettoyés
    QString userCleaned = smtpUser;
    QString passwordCleaned = smtpPassword;
    
    // Afficher un message de progression
    ui->label_error->setText("Envoi de l'email en cours...");
    ui->label_error->setStyleSheet("color: #4d73ff;");
    ui->label_error->setVisible(true);
    QApplication::processEvents();
    
    // Construire le message
    QString nomComplet = QString("%1 %2").arg(prenomEmploye, nomEmploye).trimmed();
    if (nomComplet.isEmpty()) {
        nomComplet = "Cher employé";
    }
    
    QString subject = "Récupération de votre mot de passe - Application Gestion Employés";
    QString body = QString(
        "========================================\n"
        "  RECUPERATION DE MOT DE PASSE\n"
        "  Application Gestion Employés\n"
        "========================================\n\n"
        "Bonjour %1,\n\n"
        "Vous avez demandé la récupération de votre mot de passe.\n\n"
        "VOICI VOS IDENTIFIANTS DE CONNEXION :\n\n"
        "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
        "  EMAIL : %2\n"
        "  MOT DE PASSE : %3\n"
        "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n"
        "Vous pouvez maintenant vous connecter à l'application avec ces identifiants.\n\n"
        "IMPORTANT : Pour votre sécurité, nous vous recommandons fortement de changer votre mot de passe après votre première connexion.\n\n"
        "Si vous n'avez pas fait cette demande, veuillez contacter l'administrateur immédiatement.\n\n"
        "Cordialement,\n"
        "L'équipe de l'Application Gestion Employés\n\n"
        "========================================\n")
        .arg(nomComplet, email, motDePasseEmploye);
    
    // Vérifier que les paramètres sont valides avant d'envoyer
    if (userCleaned.isEmpty() || passwordCleaned.isEmpty()) {
        QMessageBox::warning(this, "Configuration invalide",
                             "Les paramètres SMTP ne sont pas valides.\n\n"
                             "Veuillez reconfigurer les paramètres SMTP.");
        return;
    }
    
    // Vérifier que le mot de passe a la bonne longueur
    if (passwordCleaned.length() != 16) {
        QMessageBox::warning(this, "Mot de passe invalide",
                             QString("Le mot de passe d'application doit contenir exactement 16 caractères.\n\n"
                                    "Longueur actuelle : %1 caractères\n\n"
                                    "Veuillez reconfigurer le mot de passe d'application.")
                             .arg(passwordCleaned.length()));
        return;
    }
    
    // Vérifier que l'email est valide
    QRegularExpression emailRegex(R"((^[\w\.-]+@[\w\.-]+\.[A-Za-z]{2,}$))");
    if (!emailRegex.match(userCleaned).hasMatch()) {
        QMessageBox::warning(this, "Email invalide",
                             "L'adresse Gmail configurée n'est pas valide.\n\n"
                             "Veuillez reconfigurer les paramètres SMTP.");
        return;
    }
    
    // Logs de débogage (sans afficher le mot de passe complet pour la sécurité)
    qDebug() << "=== Envoi email ===";
    qDebug() << "User:" << userCleaned;
    qDebug() << "Password length:" << passwordCleaned.length();
    qDebug() << "Password first 4 chars:" << passwordCleaned.left(4) << "****";
    qDebug() << "Destinataire:" << email;
    
    // Envoyer l'email
    QString error;
    SmtpClient smtp("smtp.gmail.com", 465, userCleaned, passwordCleaned);
    bool success = smtp.sendMail(userCleaned, QStringList() << email, subject, body, &error);
    
    qDebug() << "Résultat envoi:" << (success ? "SUCCÈS" : "ÉCHEC");
    if (!success) {
        qDebug() << "Erreur:" << error;
    }
    
    if (success) {
        m_emailEnvoye = true;
        ui->label_error->setText("✅ Email envoyé avec succès ! Vérifiez votre boîte de réception.");
        ui->label_error->setStyleSheet("color: #4caf50;");
        ui->label_error->setVisible(true);
        
        QMessageBox::information(this, "Email envoyé",
                                 QString("✅ Votre mot de passe a été envoyé à :\n%1\n\n"
                                        "Vérifiez votre boîte Gmail pour recevoir votre mot de passe.\n\n"
                                        "Vous pouvez maintenant vous connecter avec votre email et votre mot de passe.")
                                 .arg(email));
        
        // Fermer le dialogue après un court délai
        QTimer::singleShot(2000, this, [this]() {
            accept();
        });
    } else {
        ui->label_error->setText("❌ Erreur lors de l'envoi de l'email.");
        ui->label_error->setStyleSheet("color: #ff8a80;");
        ui->label_error->setVisible(true);
        
        // Message d'erreur avec option de réinitialisation
        int ret = QMessageBox::critical(this, "Erreur d'envoi",
            QString("❌ Impossible d'envoyer l'email.\n\n"
                   "Erreur : %1\n\n"
                   "Voulez-vous réinitialiser la configuration SMTP ?")
            .arg(error),
            QMessageBox::Yes | QMessageBox::No,
            QMessageBox::Yes);
        
        if (ret == QMessageBox::Yes) {
            // Réinitialiser la configuration
            QSettings settings;
            settings.remove("smtp/user");
            settings.remove("smtp/password");
            
            QMessageBox::information(this, "Configuration réinitialisée",
                                    "La configuration SMTP a été réinitialisée.\n\n"
                                    "Veuillez reconfigurer les paramètres SMTP.");
            
            // Réessayer avec une nouvelle configuration
            return envoyerEmailAutomatiquement(email);
        }
    }
}

void ForgotPasswordDialog::envoyerEmailTest(const QString& emailDestinataire)
{
    // Configuration Resend API
    QString resendApiKey = "re_WRuNQxQG_DDVjwaGhpyyK5vPJZ5iZZpji";
    QString fromEmail = "onboarding@resend.dev"; // Email par défaut Resend
    
    // Afficher message de progression
    ui->label_error->setText("📧 Envoi de l'email de test en cours...");
    ui->label_error->setStyleSheet("color: #4d73ff;");
    ui->label_error->setVisible(true);
    QApplication::processEvents();
    
    // Préparer le message de test
    QString subject = "[TEST] Email de test - Application Gestion Employés";
    QString body = QString(
        "========================================\n"
        "  EMAIL DE TEST\n"
        "  Application Gestion Employés\n"
        "========================================\n\n"
        "Bonjour,\n\n"
        "Ceci est un email de test pour vérifier le bon fonctionnement\n"
        "du système d'envoi d'emails de l'application.\n\n"
        "Si vous recevez ce message, cela signifie que le système\n"
        "de mailing fonctionne correctement !\n\n"
        "Date et heure : %1\n\n"
        "Cordialement,\n"
        "L'équipe de développement\n\n"
        "========================================\n")
        .arg(QDateTime::currentDateTime().toString("dd/MM/yyyy hh:mm:ss"));
    
    qDebug() << "=== TEST ENVOI EMAIL VIA RESEND ===";
    qDebug() << "De:" << fromEmail;
    qDebug() << "À:" << emailDestinataire;
    qDebug() << "Sujet:" << subject;
    
    // Envoyer l'email via curl
    QString error;
    CurlEmailer emailer;
    bool success = emailer.sendEmail(emailDestinataire, subject, body, &error);
    
    qDebug() << "Résultat:" << (success ? "SUCCÈS ✅" : "ÉCHEC ❌");
    if (!success) {
        qDebug() << "Erreur:" << error;
    }
    
    if (success) {
        ui->label_error->setText("✅ Email de test envoyé avec succès !");
        ui->label_error->setStyleSheet("color: #4caf50;");
        ui->label_error->setVisible(true);
        
        QMessageBox::information(this, "Email envoyé",
                                 QString("✅ Email de test envoyé avec succès à :\n%1\n\n"
                                        "Vérifiez la boîte de réception.")
                                 .arg(emailDestinataire));
        return;
    } else {
        ui->label_error->setText("❌ Erreur lors de l'envoi");
        ui->label_error->setStyleSheet("color: #ff8a80;");
        ui->label_error->setVisible(true);
        
        QMessageBox::critical(this, "Erreur d'envoi",
            QString("❌ Impossible d'envoyer l'email de test.\n\n"
                   "Erreur : %1\n\n"
                   "Vérifiez votre connexion Internet.")
            .arg(error));
    }
}


