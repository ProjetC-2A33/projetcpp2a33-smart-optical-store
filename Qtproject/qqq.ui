    <string notr="true">
/* Style for QGroupBox */


/* Style for QLineEdit (input box) */
QLineEdit {
    background-color: #3498db; /* Blue color for input boxes */
    border: 1px solid #2980b9; /* Border color for input boxes */
    border-radius: 5px; /* Border radius for input boxes */
    padding: 5px; /* Padding for input boxes */
    color: black; /* Text color inside input boxes */
}

/* Style for QLabel (text label) */
QLabel {
    color: black; /* Text color for labels */
    font-size: 16px; /* Adjust font size as needed */
    font-weight: bold; /* Make the text bold if desired */
    margin: 5px; /* Adjust margin as needed */
}

/* Style for QPushButton */
QPushButton {
    background-color: #3498db; /* Blue color for buttons */
    border: 1px solid #2980b9; /* Border color for buttons */
    border-radius: 5px; /* Border radius for buttons */
    padding: 5px 10px; /* Adjust padding as needed */
    color: white; /* Text color on buttons */
}

/* Additional styling for better appearance */
QPushButton:hover {
    background-color: #2980b9; /* Darker blue on hover */
}

QPushButton:pressed {
    background-color: #21618c; /* Even darker blue when pressed */
}

/* Add more styles as needed for your specific application */
</string>
